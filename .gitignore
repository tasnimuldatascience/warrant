.coverage
htmlcov/
.mypy_cache/

# Everything under data/ is reproducible from
#   warrant corpus fetch  ->  warrant corpus build  ->  warrant index build
# The eCFR snapshot cache alone is a few hundred MB of XML. None of it belongs in git.
data/
# runs/ is scratch: every eval invocation writes here. The canonical run records behind the
# published failure budget are copied into results/ and ARE tracked, so a reader can audit
# the numbers without re-running anything.
runs/
*.parquet
*.npy
*.pkl
*.gguf
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

.env
.DS_Store
Thumbs.db

# Build intermediates for the film and the architecture loop. `media/_voice/` is the
# per-line TTS plus its duration manifest, and `media/film.html` is the template with the
# measured timeline baked in -- both are regenerated by scripts/voice.py, scripts/film.py
# and scripts/architecture.py. The finished mp4/gif/srt ARE tracked.
media/_voice/
media/_pw/
media/_arch/
media/film.html
media/_film.*
media/_arch.webm
media/_arch-palette.png
