{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `import "./styles.css"` and the woff2 the stylesheet pulls in are Vite's module graph,
    // not TypeScript's. Without this the entry point does not typecheck at all.
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  // `*.test.ts` runs under Node's own type-stripping test runner (`node --test`), not this
  // project -- it imports `node:test`/`node:assert`, and typing those needs `@types/node`,
  // which nothing else here depends on. Excluding keeps `tsc -b` clean without adding it.
  "exclude": ["src/**/*.test.ts"]
}
